              <geom class="visual" rgba="0.79608 0.82353 0.93725 1" mesh="left_foot"/>
              <geom class="collision" size="0.022" pos="0 0 -0.005" rgba="0.79608 0.82353 0.93725 1"/>
            </body>
          </body>
        </body>
      </body>
      <body name="right_hip" pos="-0.050885 -0.074277 -0.0825">
        <inertial pos="0.0801754 0.0230111 4.672e-05" quat="0.567983 0.580028 0.409732 0.416032" mass="0.963523" diaginertia="0.00115347 0.000949831 0.000528374"/>
        <joint name="right_hip_joint" pos="0 0 0" axis="1 0 0" range="-0.48 0.48" class="EC-A8112-P1-18_joint"/>
        <geom class="visual" rgba="0.3098 0.3098 0.3098 1" mesh="right_hip"/>
        <geom class="collision" size="0.0525 0.0265" pos="0.08826 0.0255 0" quat="0.707388 0.706825 0 0" type="cylinder" rgba="0.3098 0.3098 0.3098 1"/>
        
        <body name="right_thigh" pos="0.088264 -0.068 0">
          <inertial pos="-0.00235188 0.00133928 -0.0195019" quat="0.962516 0.120213 -0.0562232 0.236537" mass="1.4784" diaginertia="0.00616074 0.00573419 0.0016712"/>
          <joint name="right_thigh_joint" pos="0 0 0" axis="0 1 0" range="-1.23 2.73" class="EC-A8112-P1-18_joint"/>
          <geom class="visual" rgba="0.37255 1 0.81176 1" mesh="right_thigh"/>
          <geom class="collision" size="0.0525 0.04516" pos="0 -0.00316 0" quat="0.707388 0.706825 0 0" type="cylinder" rgba="0.37255 1 0.81176 1"/>
          <geom class="collision" size="0.02 0.019905 0.129745" pos="-0.02 -0.034 -0.08" quat="0.99875 0 -0.0499792 0" type="box" rgba="0.37255 1 0.81176 1"/>
          
          <body name="right_calf" pos="0 -0.034 -0.2">
            <inertial pos="0.071716 -3.6905e-08 -0.064562" quat="0.656508 -0.262672 -0.262672 0.656508" mass="0.16311" diaginertia="0.00098076 0.000961826 2.89736e-05"/>
            <joint name="right_calf_joint" pos="0 0 0" axis="0 1 0" range="-1.98 0" class="EC-A8112-P1-18_joint"/>
            <geom class="visual" rgba="0.3098 0.3098 0.3098 1" mesh="right_calf"/>
            <geom class="collision" size="0.015 0.011 0.1" pos="0.07 0 -0.06" quat="0.930508 0 -0.366273 0" type="box" rgba="0.3098 0.3098 0.3098 1"/>
            
            <body name="right_foot" pos="0.13331 0 -0.14318">
              <inertial pos="0.00024867 3.8242e-09 -0.011848" quat="-1.66636e-05 0.699648 1.70171e-05 0.714487" mass="0.026651" diaginertia="5.72922e-06 4.4015e-06 3.62888e-06"/>
              <geom class="visual" rgba="0.79608 0.82353 0.93725 1" mesh="right_foot"/>
              <geom class="collision" size="0.022" pos="0 0 -0.005" rgba="0.79608 0.82353 0.93725 1"/>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor class="EC-A8112-P1-18_motor" name="left_hip" joint="left_hip_joint" />
    <motor class="EC-A8112-P1-18_motor" name="left_thigh" joint="left_thigh_joint" />
    <motor class="EC-A8112-P1-18_motor" name="left_calf" joint="left_calf_joint" />
    <motor class="EC-A8112-P1-18_motor" name="right_hip" joint="right_hip_joint" />
    <motor class="EC-A8112-P1-18_motor" name="right_thigh" joint="right_thigh_joint" />
    <motor class="EC-A8112-P1-18_motor" name="right_calf" joint="right_calf_joint" />
  </actuator>

  <!-- imu, joint pos and joint vel sensor-->
  <sensor>

    <jointpos name="left_hip_pos" joint="left_hip_joint" />
    <jointpos name="left_thigh_pos" joint="left_thigh_joint" />
    <jointpos name="left_calf_pos" joint="left_calf_joint" />
    <jointpos name="right_hip_pos" joint="right_hip_joint" />
    <jointpos name="right_thigh_pos" joint="right_thigh_joint" />
    <jointpos name="right_calf_pos" joint="right_calf_joint" />

    <jointvel name="left_hip_vel" joint="left_hip_joint" />
    <jointvel name="left_thigh_vel" joint="left_thigh_joint" />
    <jointvel name="left_calf_vel" joint="left_calf_joint" />
    <jointvel name="right_hip_vel" joint="right_hip_joint" />
    <jointvel name="right_thigh_vel" joint="right_thigh_joint" />
    <jointvel name="right_calf_vel" joint="right_calf_joint" />

    <framequat objtype="site" objname="imu" name="imu_quat"/>
    <gyro site="imu" name="imu_gyro"/>
    <accelerometer site="imu" name="imu_accel"/>
  </sensor>

  <keyframe>
        <key name="home"
             qpos="0 0 0.4 1 0 0 0
                   0.332 1.22 -1.98 -0.316 1.22 -1.98"
            ctrl="0.332 1.22 -1.98 -0.316 1.22 -1.98"
        />
    </keyframe>
</mujoco>
