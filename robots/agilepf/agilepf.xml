<?xml version='1.0' encoding='UTF-8'?>
<mujoco model="agilepf">
  <compiler angle="radian" meshdir="./meshes/"/>

  <default>
    <!-- visual -->
    <!-- contype="0" 和 conaffinity="0" 表示该几何体不会与任何物体碰撞（包括地面） -->
    <default class="visual">
      <geom contype="0" conaffinity="0" group="1" type="mesh" density="0"/>
    </default>

    <!-- collision -->
    <!-- default geom for collision geometries -->
    <default class="collision">
      <geom contype="1" conaffinity="1" condim="3" friction="0.6 0.005 0.0001" margin="0.001" group="3" />
    </default>

    <!-- joint -->
    <default class="EC-A8112-P1-18_joint">
      <!-- armature value here is the provided rotor inertia(kg*m^2) multiplied by the square of the gear ratio -->
      <!-- rotor inertia and gear ratio can be checked in https://www.encos.cn -->
      <joint armature="0.04752756" type="hinge" actuatorfrcrange="-90 90"/>
    </default>

    <!-- motor -->
    <default class="EC-A8112-P1-18_motor">
      <motor ctrllimited="true" ctrlrange="-90 90"/>
    </default>

  </default>

  <asset>
    <mesh name="base" file="base.STL"/>
    <mesh name="left_hip" file="left_hip.STL"/>
    <mesh name="left_thigh" file="left_thigh.STL"/>
    <mesh name="left_calf" file="left_calf.STL"/>
    <mesh name="left_foot" file="left_foot.STL"/>
    <mesh name="right_hip" file="right_hip.STL"/>
    <mesh name="right_thigh" file="right_thigh.STL"/>
    <mesh name="right_calf" file="right_calf.STL"/>
    <mesh name="right_foot" file="right_foot.STL"/>
  </asset>
  <worldbody>
    <!-- set initial pos and euler of base link -->
    <body name="base" pos="0 0 0.41" euler="0 0.1 0">
      <!-- Add freejoint will add additional 7 dofs -->
      <freejoint name="base_free_joint"/>
      <!-- add imu site for sensor measurement -->
      <site name="imu" pos="0 0 0"/>

      <inertial pos="-0.0178297 -0.00108765 0.0273782" quat="0.969694 -0.0268392 -0.242183 -0.0178857" mass="6.90136" diaginertia="0.0880321 0.0785021 0.0542606"/>
      <geom class="visual" rgba="0.75294 0.75294 0.75294 1" mesh="base"/>
      <geom class="collision" size="0.115 0.131 0.0345" pos="0 0 0.0345" type="box" rgba="0.75294 0.75294 0.75294 1"/>

      <camera name="depth_camera" pos="0.11154 -0.00072 0.10151" euler="0 -1.27 -1.57" mode="fixed"
              fovy="62"/> <!-- fovy the same as D435i for 4:3 aspect ratio -->

      <body name="battery_box" pos="0 0 0.1495">
        <inertial pos="0 0 0" mass="0.001" diaginertia="1e-10 1e-10 1e-10"/>
        <geom class="collision" size="0.0745 0.1 0.0415" pos="0 0 -0.0415" type="box"/>
      </body>
      <body name="back_shield" pos="-0.10423 -0.00072 -0.06106">
        <inertial pos="0 0 0" mass="0.001" diaginertia="1e-10 1e-10 1e-10"/>
        <geom class="collision" size="0.002 0.131 0.03" pos="0.002 0 0.025" type="box"/>
        <geom class="collision" size="0.002 0.065 0.068" pos="0.002 0 -0.00944" type="box"/>
      </body>
      <body name="fore_shield" pos="0.10377 -0.00072 -0.05696">
        <inertial pos="0 0 0" mass="0.001" diaginertia="1e-10 1e-10 1e-10"/>
        <geom class="collision" size="0.002 0.131 0.068" pos="-0.002 0 -0.01354" type="box"/>
      </body>
      <body name="left_rounded_corner" pos="-0.10223 0.07572 -0.0825">
        <inertial pos="0 0 0" mass="0.001" diaginertia="1e-10 1e-10 1e-10"/>
        <geom class="collision" size="0.056 0.002" pos="-0.002 0 0" quat="0.707388 0 0.706825 0" type="cylinder"/>
      </body>
      <body name="right_rounded_corner" pos="-0.10223 -0.07572 -0.0825">
