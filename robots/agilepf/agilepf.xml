        <geom class="collision" size="0.056 0.002" pos="-0.002 0 0" quat="0.707388 0 0.706825 0" type="cylinder"/>
      </body>
      <body name="left_hip_motor" pos="-0.08738 0.07572 -0.0825">
        <inertial pos="0 0 0" mass="0.001" diaginertia="1e-10 1e-10 1e-10"/>
        <geom class="collision" size="0.0525 0.0265" pos="0.01165 0 0" quat="0.707388 0 0.706825 0" type="cylinder"/>
      </body>
      <body name="right_hip_motor" pos="-0.08738 -0.07572 -0.0825">
        <inertial pos="0 0 0" mass="0.001" diaginertia="1e-10 1e-10 1e-10"/>
        <geom class="collision" size="0.0525 0.0265" pos="0.01165 0 0" quat="0.707388 0 0.706825 0" type="cylinder"/>
      </body>

      <body name="left_hip" pos="-0.050885 0.075723 -0.0825">
        <inertial pos="0.0801801 -0.0230168 -0.0001447" quat="0.412935 0.412965 0.576746 0.571235" mass="0.963301" diaginertia="0.00115291 0.000949573 0.000528046"/>
        <joint name="left_hip_joint" pos="0 0 0" axis="1 0 0" range="-0.48 0.48" class="EC-A8112-P1-18_joint"/>
        <geom class="visual" rgba="0.3098 0.3098 0.3098 1" mesh="left_hip"/>
        <geom class="collision" size="0.0525 0.0265" pos="0.08826 -0.0255 0" quat="0.707388 0.706825 0 0" type="cylinder" rgba="0.3098 0.3098 0.3098 1"/>
        
        <body name="left_thigh" pos="0.088264 0.068 0">
          <inertial pos="-0.00253991 -0.00142269 -0.0199369" quat="0.954786 -0.120597 -0.059504 -0.26514" mass="1.4731" diaginertia="0.00613714 0.00569365 0.00168771"/>
          <joint name="left_thigh_joint" pos="0 0 0" axis="0 1 0" range="-1.23 2.73" class="EC-A8112-P1-18_joint"/>
          <geom class="visual" rgba="0.87451 0.68627 1 1" mesh="left_thigh"/>
          <geom class="collision" size="0.0525 0.04516" pos="0 0.00316 0" quat="0.707388 0.706825 0 0" type="cylinder" rgba="0.87451 0.68627 1 1"/>
          <geom class="collision" size="0.02 0.019905 0.129745" pos="-0.02 0.034 -0.08" quat="0.99875 0 -0.0499792 0" type="box" rgba="0.87451 0.68627 1 1"/>

          <body name="left_calf" pos="0 0.034 -0.2">
            <inertial pos="0.071716 -3.691e-08 -0.064562" quat="0.656508 -0.262672 -0.262672 0.656508" mass="0.16311" diaginertia="0.00098076 0.000961826 2.89736e-05"/>
            <joint name="left_calf_joint" pos="0 0 0" axis="0 1 0" range="-1.98 0" class="EC-A8112-P1-18_joint"/>
